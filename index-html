<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Escáner QR Profesional</title>
    <!-- Librería oficial de QR -->
    <script src="https://unpkg.com/html5-qrcode"></script>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            text-align: center;
            background: #f0f2f5;
            margin: 0;
            padding: 20px;
        }

        .box {
            background: white;
            padding: 25px;
            border-radius: 20px;
            max-width: 450px;
            margin: auto;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        h2 {
            color: #1a73e8;
            margin-top: 0;
        }

        #reader {
            width: 100%;
            border-radius: 15px;
            overflow: hidden;
            background: #000;
            margin-bottom: 20px;
        }

        input {
            width: 100%;
            padding: 15px;
            margin-bottom: 15px;
            border: 2px solid #eee;
            border-radius: 10px;
            box-sizing: border-box;
            font-size: 16px;
            text-align: center;
        }

        button {
            width: 100%;
            padding: 15px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
            transition: background 0.3s;
        }

            button:hover {
                background: #218838;
            }

            button:disabled {
                background: #ccc;
                cursor: not-allowed;
            }

        #msg {
            margin-top: 15px;
            font-weight: 500;
            color: #666;
        }
    </style>
</head>
<body>

    <div class="box">
        <h2>Escáner QR</h2>
        <div id="reader"></div>
        <input type="text" id="resultado" placeholder="El código aparecerá aquí..." readonly>
        <button id="btnEnviar" onclick="enviarDatos()">ENVIAR A MAKE</button>
        <p id="msg">Iniciando cámara...</p>
    </div>

    <script>
        // Configuración
        const URL_MAKE = "https://hook.us2.make.com/7nfgc21f08o4a2uqxvqbt06aqoa119kv";

        // Función para actualizar mensajes en pantalla
        function actualizarEstado(texto, color = "#666") {
            const msg = document.getElementById('msg');
            msg.innerText = texto;
            msg.style.color = color;
        }

        // 1. Al detectar el QR
        function alDetectarQR(textoCodificado) {
            document.getElementById('resultado').value = textoCodificado;
            actualizarEstado("¡QR detectado con éxito!", "#28a745");
            // Opcional: enviarDatos(); // Descomenta si quieres envío automático
        }

        // 2. Al fallar el escaneo (error de lectura común)
        function alFallarEscaneo(error) {
            // No mostramos nada para no llenar la consola, es normal que falle mientras busca
        }

        // 3. Enviar a Make
        function enviarDatos() {
            const dato = document.getElementById('resultado').value;
            const btn = document.getElementById('btnEnviar');

            if (!dato) {
                alert("Primero debes escanear un código QR");
                return;
            }

            btn.disabled = true;
            actualizarEstado("Enviando a Make...", "#1a73e8");

            fetch(URL_MAKE + "?qr=" + encodeURIComponent(dato), {
                method: 'GET',
                mode: 'no-cors'
            })
                .then(() => {
                    alert("¡Dato enviado correctamente!");
                    actualizarEstado("Enviado con éxito", "#28a745");
                })
                .catch(err => {
                    console.error("Error:", err);
                    actualizarEstado("Error al enviar", "#dc3545");
                })
                .finally(() => {
                    btn.disabled = false;
                });
        }

        // 4. Iniciar el Escáner
        try {
            const html5QrcodeScanner = new Html5QrcodeScanner(
                "reader",
                { fps: 10, qrbox: { width: 250, height: 250 } },
                /* verbose= */ false
            );

            html5QrcodeScanner.render(alDetectarQR, alFallarEscaneo);
            actualizarEstado("Cámara lista. Apunta a un QR.");
        } catch (e) {
            actualizarEstado("Error al iniciar cámara: " + e.message, "#dc3545");
        }

        // Configuración avanzada para detectar QR difíciles
        const config = {
            fps: 20,           // Aumentamos los cuadros por segundo (más rápido)
            qrbox: { width: 280, height: 280 }, // Cuadro un poco más grande
            aspectRatio: 1.0,  // Forzamos formato cuadrado para mejor enfoque
            rememberLastUsedCamera: true,
            supportedScanTypes: [Html5QrcodeScanType.SCAN_TYPE_CAMERA]
        };

        const html5QrcodeScanner = new Html5QrcodeScanner(
            "reader", config, /* verbose= */ false
        );

        html5QrcodeScanner.render(alDetectarQR, alFallarEscaneo);

    </script>

</body>
</html>
